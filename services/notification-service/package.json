{
  "name": "notification-service",
  "version": "1.0.0",
  "main": "app.js",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ],
    "roots": [
      "<rootDir>/tests"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
