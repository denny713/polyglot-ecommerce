{
  "name": "ecommerce-gateway",
  "port": 7100,
  "timeout": "10s",
  "cache_ttl": "0s",
  "read_timeout": "10s",
  "write_timeout": "10s",
  "idle_timeout": "60s",
  "read_header_timeout": "5s",
  "debug_endpoint": false,
  "echo_endpoint": false,
  "swagger": {
    "enabled": true
  },
  "jwt": {
    "jwk_url": "http://host.docker.internal:8080/realms/ecommerce/protocol/openid-connect/certs",
    "jwk_url_env": "JWK_URL",
    "issuer": "http://localhost:8080/realms/ecommerce",
    "issuer_env": "KEYCLOAK_ISSUER_URI",
    "disable_jwk_security": true,
    "cache_duration": 900,
    "default_roles": [
      "user",
      "admin"
    ]
  },
  "cors": {
    "allow_origins": [
      "*"
    ],
    "allow_methods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "allow_headers": [
      "Origin",
      "Authorization",
      "Content-Type",
      "Accept",
      "Accept-Language",
      "X-Request-Id"
    ],
    "expose_headers": [
      "Content-Length",
      "Content-Type",
      "X-Correlation-Id"
    ],
    "allow_credentials": false,
    "max_age": "12h",
    "debug": false
  },
  "rate_limit": {
    "auth": {
      "strategy": "ip",
      "client_max_rate": 1,
      "client_capacity": 5,
      "every": "1s"
    }
  }
}