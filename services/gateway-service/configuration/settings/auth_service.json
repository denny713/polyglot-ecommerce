{
  "host": "http://host.docker.internal:8081",
  "timeout": "10s",
  "input_headers": [
    "Content-Type",
    "Accept",
    "Accept-Language",
    "User-Agent",
    "Origin",
    "Referer",
    "X-Request-Id",
    "X-Forwarded-For"
  ],
  "login_rate_limit": {
    "strategy": "ip",
    "client_max_rate": 1,
    "client_capacity": 5,
    "every": "1s"
  }
}
