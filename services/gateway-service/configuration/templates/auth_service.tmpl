{{/*
  Endpoints proxied to auth-service (Quarkus).

  Both endpoints are declared with no-op encoding on the endpoint *and* the
  backend. That is deliberate: with the default "json" encoding KrakenD parses
  the backend response and answers 500 for anything that is not a 2xx, which
  would flatten auth-service's 401 / 403 / 429 / 503 into a single opaque
  error and drop the ErrorResponse body. no-op forwards the status code, the
  headers and the raw body untouched, so the contract clients see through the
  gateway is exactly the contract auth-service publishes.

  The host defaults to settings/auth_service.json and can be overridden at
  container start with AUTH_SERVICE_HOST — that is what lets the same image
  point at localhost during development and at a service name once
  auth-service itself moves into the compose network.
*/}}
{{ $host := .auth_service.host }}
{{- if env "AUTH_SERVICE_HOST" }}{{ $host = env "AUTH_SERVICE_HOST" }}{{ end }}
{
      "endpoint": "/api/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "timeout": "{{ .auth_service.timeout }}",
      "input_headers": {{ marshal .auth_service.input_headers }},
      "extra_config": {
        "qos/ratelimit/router": {{ marshal .auth_service.login_rate_limit }}
      },
      "backend": [
        {
          "url_pattern": "/api/auth/login",
          "method": "POST",
          "encoding": "no-op",
          "host": ["{{ $host }}"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/logout",
      "method": "POST",
      "output_encoding": "no-op",
      "timeout": "{{ .auth_service.timeout }}",
      "input_headers": {{ marshal .auth_service.input_headers }},
      "backend": [
        {
          "url_pattern": "/api/auth/logout",
          "method": "POST",
          "encoding": "no-op",
          "host": ["{{ $host }}"]
        }
      ]
    }