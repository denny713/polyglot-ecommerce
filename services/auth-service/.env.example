_DEV_QUARKUS_KEYCLOAK_DEVSERVICES_ENABLED=

QUARKUS_HTTP_PORT=

QUARKUS_OIDC_AUTH_SERVER_URL=
QUARKUS_OIDC_CLIENT_ID=
QUARKUS_OIDC_CREDENTIALS_SECRET=
QUARKUS_OIDC_APPLICATION_TYPE=
QUARKUS_OIDC_TOKEN_AUDIENCE=

KEYCLOAK_AUTH_REALM=
KEYCLOAK_AUTH_CLIENT_ID=
KEYCLOAK_AUTH_CLIENT_SECRET=
KEYCLOAK_AUTH_SCOPE=

# Service account for the Keycloak Admin REST API, used by /api/account.
# The confidential auth-service client — not the public one above — whose
# service account holds the realm-management roles manage-users and
# view-users. app/init/keycloak-init.sh creates it and prints the secret.
KEYCLOAK_ADMIN_API_CLIENT_ID=
KEYCLOAK_ADMIN_API_CLIENT_SECRET=

# Email carrying the password generated at registration. MOCK=true writes the
# message to the log instead of sending it — the usual choice for local dev.
# app/docker-compose.yml runs Mailpit on 1025 (web UI on 8025) to catch real ones.
QUARKUS_MAILER_FROM=
QUARKUS_MAILER_MOCK=
QUARKUS_MAILER_HOST=
QUARKUS_MAILER_PORT=

QUARKUS_REST_CLIENT_KEYCLOAK_TOKEN_API_URL=
QUARKUS_REST_CLIENT_KEYCLOAK_TOKEN_API_CONNECT_TIMEOUT=
QUARKUS_REST_CLIENT_KEYCLOAK_TOKEN_API_READ_TIMEOUT=

# Path permissions are NOT here: they are the security posture of the service,
# not a credential, so they live in src/main/resources/application.properties
# and are in version control. Override them here only for a deployment that
# genuinely needs different ones.

QUARKUS_LOG_CATEGORY__COM_ECOMMERCE_AUTH__LEVEL=
