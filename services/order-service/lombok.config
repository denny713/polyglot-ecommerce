# Marks everything Lombok generates with @lombok.Generated, which JaCoCo
# recognises and leaves out of its counters. Without this, coverage would be
# dominated by generated getters, setters, constructors and equals/hashCode --
# and the only way to reach a target would be writing tests for code nobody
# wrote.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
